{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":dependencyDashboardApproval",
        "helpers:pinGitHubActionDigests"
    ],
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "labels": [
        "dependencies"
    ],
    "nuget": {
        "ignorePaths": []
    },
    "packageRules": [
        {
            "matchDepNames": [
                "dotnet-sdk"
            ],
            "enabled": false
        },
        {
            "description": "The generator must reference the Roslyn version of the minimum supported SDK; bump it deliberately.",
            "matchFileNames": [
                "src/DecoratR.Generator/**"
            ],
            "matchPackageNames": [
                "Microsoft.CodeAnalysis.CSharp",
                "Microsoft.CodeAnalysis.Common",
                "Microsoft.CodeAnalysis.Analyzers"
            ],
            "enabled": false
        },
        {
            "matchDepNames": [
                "decoratR**"
            ],
            "groupName": "DecoratR packages",
            "automerge": true
        }
    ]
}