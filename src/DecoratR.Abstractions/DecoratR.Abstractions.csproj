<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Workaround for Directory.Build.props defining TargetFramework -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Title>DecoratR Abstractions</Title>
    <Description>Core DecoratR interfaces, attributes and options for defining requests, handlers, and decorators in .NET applications.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
